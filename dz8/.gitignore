# Output is generated by test runs; only golden records are committed.
output/
!golden/baseline/
!golden/baseline/**

# Local CLI logs from manual stand runs
logs/

# Working audit notes; the shipped docs live in docs/user-guide.md,
# docs/glossary.md and docs/tabs/.
docs/review.md
docs/test_recommendations.md
docs/missing_tests.md

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Tool caches
.ruff_cache/
.mypy_cache/

# Virtual environment
.venv/

# Temporary files
*.tmp
