# Shared ollama (ohw-infra) for the whole homework monorepo.
# Launch once / after reboot:
#   docker compose -f infra/compose.yaml up -d
#   docker compose -f infra/compose.yaml logs -f
#   docker compose -f infra/compose.yaml stop # free port 11434 before a standalone project run
OLLAMA_MODEL=qwen2.5:7b-instruct

