# Файл настройки подключения к локальной LLM для Docker Compose.
# Compose читает этот файл автоматически и подставляет значения
# в окружение контейнеров (сервис ollama и приложение app).
#
# Как пользоваться: меняйте значения здесь и перезапускайте
#   docker compose up --build
#
# Обычно достаточно менять OLLAMA_MODEL. Значения, заданные в окружении
# Windows/терминала, при запуске через Compose перекрываются именно этим
# файлом (у Compose он приоритетнее), поэтому правьте сюда.

# Имя модели, установленной в ollama (например, qwen2.5:7b-instruct,
# llama3.2:3b, phi3:mini).
OLLAMA_MODEL=qwen2.5:7b-instruct

# Адрес сервиса ollama.
# - внутри docker compose:   http://ollama:11434
# - локальный запуск:        http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434