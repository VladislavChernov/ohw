FROM python:3.13-slim-bookworm

RUN pip install --no-cache-dir uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --no-dev --frozen

# библиотеки ML ставятся pip'ом в .venv сервисного образа (не требуют правки uv.lock)
#
# torch ставится ОТДЕЛЬНО и с CPU-индекса. Обычный `pip install torch` на машине с
# драйвером NVIDIA тянет CUDA-сборку вместе с nvidia-cuDNN, cuBLAS, NCCL и triton —
# это около 3 ГБ, которые реранкеру не нужны: он по конфигурации работает на CPU
# (compose.yaml, блок reranker: «bge-reranker-base на CPU»), а видеокарта занята LLM.
# sentence-transformers ставится вторым шагом с обычного индекса: на индексе pytorch
# его нет, и одной командой с --index-url он бы не поставился.
RUN uv pip install --python /app/.venv/bin/python --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu torch \
 && uv pip install --python /app/.venv/bin/python --no-cache-dir sentence-transformers

ENV DOMAIN_PROFILES_DIR=/app/domain_profiles \
    CONFIG_DB_PATH=/app/runtime/config.db

ENTRYPOINT ["uv", "run", "--no-sync"]
CMD ["graphrag-reranker"]